# ─────────────────────────────────────────────────────────────────────────────
# Crop Health & Pest Advisory System — Environment Variables Template
# Copy this file to .env and fill in real values. NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=cropuser
POSTGRES_PASSWORD=croppass
POSTGRES_DB=cropdb
# Full async URL used by SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://cropuser:croppass@localhost:5432/cropdb

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_to_a_long_random_secret_at_least_32_chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440   # 24 hours

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
# Set to "mock" to log OTPs to console (dev). Set to "twilio" or "msg91" in production.
OTP_PROVIDER=mock
# Twilio (used when OTP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# MSG91 (used when OTP_PROVIDER=msg91)
MSG91_API_KEY=
MSG91_SENDER_ID=

# ── External APIs (Phase 8+) ──────────────────────────────────────────────────
WEATHER_API_KEY=
MAPS_API_KEY=

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,exp://localhost:8081

ML_SERVICE_URL=http://localhost:8001/predict
